{
  "name": "umpire-extensions",
  "version": "1.0.0",
  "private": true,
  "description": "UMPIRE browser extensions (Chrome + Firefox) for target health and outage notifications",
  "type": "module",
  "scripts": {
    "dev": "wxt",
    "dev:firefox": "wxt -b firefox --mv3",
    "build": "wxt build",
    "build:firefox": "wxt build -b firefox --mv3",
    "zip": "wxt zip",
    "zip:firefox": "wxt zip -b firefox --mv3",
    "icons": "node scripts/build-icons.mjs",
    "playwright:install": "playwright install chromium",
    "store:screenshots": "node scripts/capture-screenshots.mjs",
    "store:screenshots:all": "playwright install chromium && node scripts/capture-screenshots.mjs",
    "store:screenshots:prep": "node scripts/prep-store-screenshots.mjs",
    "store:screenshots:prep:all": "playwright install chromium && node scripts/prep-store-screenshots.mjs",
    "postinstall": "wxt prepare",
    "compile": "tsc --noEmit"
  },
  "devDependencies": {
    "@resvg/resvg-js": "^2.6.2",
    "playwright": "^1.55.0",
    "typescript": "^5.7.3",
    "wxt": "^0.21.4"
  }
}
