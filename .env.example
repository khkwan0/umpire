# Host port for the web UI
WEB_PORT=8089

# Path to Firebase service account JSON (mounted into the api container)
FIREBASE_CREDENTIALS_PATH=./firebase-service-account.json

# HTTP request timeout for uptime checks (ms)
CHECK_TIMEOUT_MS=10000

# Plugins (defaults match previous behavior)
# STORE_PLUGIN=sqlite
# CHECK_PLUGIN=http
# SCHEDULER_PLUGIN=interval
# Comma-separated notifiers (fan-out). Built-ins: fcm, webhook
NOTIFY_PLUGINS=fcm

# Webhook notifier (when NOTIFY_PLUGINS includes webhook)
# WEBHOOK_URL=https://example.com/hooks/yamt
# WEBHOOK_HEADERS={"Authorization":"Bearer secret"}
