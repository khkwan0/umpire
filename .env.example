# Host port for the web UI
WEB_PORT=8089

# Path to Firebase service account JSON (mounted into the api container)
FIREBASE_CREDENTIALS_PATH=./firebase-service-account.json

# Optional Android notification channel. If unset, FCM uses the app default.
# Set this only if the client created that channel (Android 8+).
# FCM_ANDROID_CHANNEL_ID=Monitoring

# Webhook notifier config (when notify/enabled includes webhook)
# WEBHOOK_URL=https://example.com/hooks/umpire
# WEBHOOK_HEADERS={"Authorization":"Bearer secret"}
