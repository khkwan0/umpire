# Host port for the web UI
WEB_PORT=8089

# Public URL path for the UI (no trailing slash). Default `/` is
# http://localhost:8089/ or https://example.com/. If a reverse proxy
# serves the app at a subdirectory, set that path and rebuild:
#   BASE_PATH=/umpire docker compose up -d --build
# Example: https://example.com/umpire → BASE_PATH=/umpire
BASE_PATH=/
# HTTP request timeout for uptime checks (ms)
CHECK_TIMEOUT_MS=10000

# general API token for MCP, scripts, and automation (Bearer umpire_…)
# Create via Settings → API tokens or POST /api/tokens when logged in.
UMPIRE_API_TOKEN=umpire_mmRbxO80EQjE5qJASU0_hy8jQpVc16IDJx9TGwN7jnc

# Optional: built-in web agent LLM (fallback when Settings → AI Agent has no saved config)
# AGENT_LLM_PROVIDER=openai          # openai | anthropic | ollama | vllm
# OPENAI_API_KEY=sk-…
# OPENAI_MODEL=gpt-4o-mini
# OPENAI_BASE_URL=https://api.openai.com/v1
# ANTHROPIC_API_KEY=sk-ant-…
# ANTHROPIC_MODEL=claude-sonnet-4-20250514
# OLLAMA_BASE_URL=http://127.0.0.1:11434/v1
# OLLAMA_MODEL=llama3.2
# VLLM_BASE_URL=http://127.0.0.1:8000/v1
# VLLM_MODEL=your-model
# AGENT_MAX_TOOL_ROUNDS=12

# Optional Android notification channel. If unset, FCM uses the app default.
# Set this only if the client created that channel (Android 8+).
# FCM_ANDROID_CHANNEL_ID=Monitoring
