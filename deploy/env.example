# Copy to .env in the directory where you run docker compose:
#   cp deploy/env.example .env
#
# Used by docker-compose.hub.yml (and compatible with docker-compose.yml).

# Published images (Docker Hub defaults)
UMPIRE_IMAGE_REGISTRY=nitroxstudios
UMPIRE_IMAGE_TAG=latest

# Web image tag when it differs from the API tag (e.g. subdirectory builds).
# Leave unset to use UMPIRE_IMAGE_TAG. Example for https://example.com/umpire:
#   UMPIRE_WEB_IMAGE_TAG=umpire
#   BASE_PATH=/umpire
UMPIRE_WEB_IMAGE_TAG=

# Host port for the dashboard
WEB_PORT=8089

# Public URL path (no trailing slash). Must match how the web image was built.
# Root hosting: BASE_PATH=/
# Subdirectory: BASE_PATH=/umpire and use a web image tag built with that path.
BASE_PATH=/

# Persistent data directory on the host
UMPIRE_DATA_DIR=./data

# HTTP check timeout (ms)
CHECK_TIMEOUT_MS=10000

# Bootstrap admin account (required on fresh install when rbac auth plugin is enabled)
UMPIRE_ADMIN_USERNAME=admin
UMPIRE_ADMIN_PASSWORD=change-me-on-first-login
